# Copy this file to `.env` for local development.
# On Vercel, add these under Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# The "service_role" secret key. Used ONLY by the Node.js API (api/reviews.js).
# Never put this in frontend code and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random text. Used to anonymise reviewer IP addresses for spam protection.
REVIEW_IP_SALT=change-me-to-a-long-random-string

# Leave Supabase values empty during local development to save reviews in .data/reviews.json instead.
